{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "COOKIE_SECRET",
    "ENCRYPTION_KEY",
    "ANTHROPIC_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_REDIRECT_URI",
    "LINKEDIN_CLIENT_ID",
    "LINKEDIN_CLIENT_SECRET",
    "LINKEDIN_REDIRECT_URI",
    "DATAFORSEO_LOGIN",
    "DATAFORSEO_PASSWORD",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_FROM_NAME",
    "MEILISEARCH_URL",
    "MEILISEARCH_MASTER_KEY",
    "FAL_API_KEY",
    "OPENAI_API_KEY",
    "PAGESPEED_API_KEY",
    "BRIGHTDATA_USERNAME",
    "BRIGHTDATA_PASSWORD",
    "BRIGHTDATA_HOST",
    "BRIGHTDATA_PORT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "API_PORT",
    "WEB_PORT",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "ENABLE_AGENT_AUTO_QUEUE",
    "ENABLE_AI_OVERVIEWS_TRACKING",
    "CRAWL_MAX_CONCURRENCY",
    "CRAWL_DEFAULT_DELAY_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
